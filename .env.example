# ===== Telegram (UserBot / Telethon) =====
# Obtenha em https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH="seu_telegram_api_hash"
TELEGRAM_SESSION_NAME="shopee_bot_session"
# Aceita JSON list ou separado por virgula: [-100123456789,-100987654321]
SOURCE_CHANNELS=[-100123456789]

# ===== Shopee Affiliate Open API =====
# Credenciais do app em https://affiliate.shopee.com.br (Open API)
SHOPEE_APP_KEY="sua_shopee_app_key"
SHOPEE_APP_SECRET="seu_shopee_app_secret"

# ===== WhatsApp (Evolution API ou Z-API) =====
# evolution | zapi
WA_PROVIDER="evolution"
WA_API_URL="https://sua-instancia-evolution.com"
WA_API_KEY="seu_token_api_whatsapp"
WA_INSTANCE_NAME="MinhaInstancia"
WA_GROUP_JID="120363000000000000@g.us"
# Somente Z-API: token da instancia (Client-Token vai em WA_API_KEY)
WA_TOKEN=""

# ===== Opcionais =====
REQUEST_TIMEOUT=20
LOG_LEVEL="INFO"
